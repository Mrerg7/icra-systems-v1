---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "icra.systems — Premium Domain for ICRA Systems | Healthcare Compliance Platform",
  description = "Acquire icra.systems, a premium .systems domain for ICRA compliance platforms, monitoring systems, and digital tools for healthcare construction. Price available on request.",
  image = "https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/ccb64e0e-1b98-4243-8d2d-d111a277bb00/public",
  noindex = false,
} = Astro.props;

const siteUrl = 'https://icra.systems';
const siteName = 'ICRA Systems';
const contactEmail = 'sales@desertrich.com';

let pathname = Astro.url.pathname;
if (pathname !== '/' && !pathname.endsWith('/') && !pathname.includes('.')) {
  pathname += '/';
}
const canonicalURL = new URL(pathname, Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Desert Rich',
      url: siteUrl,
      email: contactEmail,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: siteName,
      description,
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      inLanguage: 'en-US',
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: image,
      },
    },
    {
      '@type': 'Product',
      name: `${siteName} — Premium Domain Name`,
      description: 'The modern .systems domain for ICRA compliance platforms, monitoring systems, and digital tools. Category-defining digital real estate for the infection control risk assessment niche.',
      url: `${siteUrl}/`,
      image: image,
      category: 'Domain Name',
      brand: {
        '@type': 'Brand',
        name: siteName,
      },
      offers: {
        '@type': 'Offer',
        url: canonicalURL,
        availability: 'https://schema.org/InStock',
        description: 'Price available on request. Flexible, escrow-protected transaction structures are available for qualified buyers.',
        seller: {
          '@type': 'Organization',
          name: 'Desert Rich',
          email: contactEmail,
        },
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="author" content="Desert Rich" />

  <!-- Google Site Verification -->
  <meta name="google-site-verification" content="d9dn_WtGYmC7K_kpjn15AHqJkBO1A8wtEMv-5rFL1ww" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body class="bg-icra-surface text-slate-900 font-sans antialiased">
  <slot />
</body>
</html>
