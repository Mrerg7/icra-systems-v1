/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; form-action 'self' mailto:; frame-ancestors 'none'; img-src 'self' data: https://imagedelivery.net; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap-*.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex

/index.html
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex
